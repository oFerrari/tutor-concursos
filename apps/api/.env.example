# Postgres (a porta 5433 evita conflito com um Postgres local na 5432)
DATABASE_URL=postgresql://tutor:tutor@localhost:5433/tutor

# LLM: gemini | ollama
LLM_PROVIDER=gemini
GEMINI_API_KEY=cole_sua_chave_aqui
GEMINI_MODEL=gemini-3.5-flash-lite

# usado apenas se LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Embeddings locais (768 dimensoes). Trocar exige recriar a coluna vector.
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# API (api.py) — assina os tokens de sessao. Gere um valor real com:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Trocar este valor invalida todo token emitido antes (todo mundo precisa logar de novo).
JWT_SECRET=troque_isto_antes_de_expor_a_api

# CLI (chat.py) opera sempre como um usuario so, resolvido por email —
# cria a conta automaticamente no primeiro uso se ainda nao existir.
CLI_USUARIO_EMAIL=estudante@local

# origens que podem chamar a API do navegador (CORS), separadas por virgula.
# default ja cobre o Next.js local (apps/web).
CORS_ORIGINS=http://localhost:3000
