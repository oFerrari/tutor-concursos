# segredos
.env

# ambiente (todo o backend Python mora em apps/api/; os padrões abaixo
# batem em qualquer profundidade, então não precisam de prefixo)
.venv/
__pycache__/
*.pyc

# material de estudo — dois destinos diferentes:
#   corpus/  leis do Planalto (sem direito autoral, art. 8º IV da Lei 9.610) → VAI pro git.
#            Resolve o bloqueio de rede corporativa: reingestão não depende de baixar de novo.
#   acervo/  PDF de cursinho, material pago → NÃO vai pro git.
acervo/

# estado de estudo: viaja no ref `estado`, NÃO no branch de código.
# Versioná-lo aqui foi a primeira tentativa e tem dois custos que o ref
# próprio não tem: conflito de merge a cada pull (JSON de 700 KB reescrito
# inteiro dos dois lados) e um commit obrigatório pra levar o dado. Ver
# .githooks/_comum.sh.
apps/api/dados/progresso.json
# Os arquivos originais do material do aluno, escritos pelo `sincronizar.py
# exportar` (024). Viajam no ref `estado`, como blobs numa subárvore — nunca no
# branch de código. Fora do git aqui pelo mesmo motivo do `acervo/`: é material
# de cursinho, e o branch de trabalho não é lugar de PDF pago.
apps/api/dados/arquivos/

# transitórios
# logs e PIDs dos processos que o setup.sh sobe (API e frontend)
.logs/
.llm_debug.txt
*.sql.bak
apps/api/db/*.sql
!apps/api/db/0[0-9][0-9]_*.sql

# monorepo JS (turborepo) — ainda sem workspace real, mas já correto pra
# quando apps/web ou packages/* existirem
node_modules/
.turbo/
.next/
dist/

# Metadado do Windows/WSL que vem colado em arquivo baixado. Não é dado.
*:Zone.Identifier
